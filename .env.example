# URL del backend usada por el servidor de Next (SSR, rutas /api/*). Privada.
# La temática vigente y la vista previa de temáticas guardadas (/api/site-theme/:id) usan esta.
API_BASE_URL=http://localhost:3101
# URL pública del backend para llamadas desde el navegador (carrito, analítica).
# Las temáticas ya no la necesitan. No pongas aquí nada secreto.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_SEND_TO=
UPLOAD_DIR=./public/uploads
CLOUDINARY_URL=
# S3 settings (production)
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=

# Debe coincidir con REVALIDATE_SECRET del backend. Vacío rechaza las peticiones (503).
REVALIDATE_SECRET=

# Debe coincidir con LOGIN_PROXY_SECRET del backend (límite de intentos por IP real).
LOGIN_PROXY_SECRET=

# Reseñas de Google Maps en la portada (opcional; solo servidor).
# Clave de Google Cloud con «Places API (New)» habilitada y restringida a esa API.
GOOGLE_PLACES_API_KEY=
# Place ID del local de Macsomenos (búscalo en developers.google.com/maps/documentation/places/web-service/place-id).
GOOGLE_PLACE_ID=

# Mismo CATALOG_SYNC_SECRET que el backend; reserva de reemplazos de fotos.
CATALOG_SYNC_SECRET=
